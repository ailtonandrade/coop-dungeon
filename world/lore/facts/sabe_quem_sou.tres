[ext_resource type="Script" path="res://world/lore/fact_def.gd" id="1_fact"]

[resource]
script = ExtResource("1_fact")
id = "sabe_quem_sou"
title = "Quem eu sou e o que vim fazer aqui"
description = "A Sinapse comprou a firma, pôs robôs no lugar e mandou todo mundo embora. Vim ao Ferro-Velho fazer uns parafusos com sucata. A sigla D3M aparece em tudo, mas ninguém sabe o que é."
source = "Meu diário, na mochila"
