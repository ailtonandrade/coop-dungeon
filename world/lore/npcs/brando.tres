[sub_resource type="Resource" id="Resource_2nycl"]
script = ExtResource("1_t0goa")
text = "Fala. Tô com a mão na graxa."

[sub_resource type="Resource" id="Resource_6fdjg"]
script = ExtResource("3_wbecq")
label = "Nome"
keywords = PackedStringArray("nome", "quem")
text = "Brando. De brando eu só tenho o nome."

[sub_resource type="Resource" id="Resource_biqi2"]
script = ExtResource("3_wbecq")
label = "Upgrade"
keywords = PackedStringArray("upgrade", "conserto", "refino", "arma")
text = "Traz a peça que eu dou um jeito. Só não me traz nada que ainda esteja se mexendo."

[sub_resource type="Resource" id="Resource_wt58u"]
script = ExtResource("3_wbecq")
label = "Helena"
keywords = PackedStringArray("helena", "doutora", "filtro")
text = "Helena? A doutora? Ela me pediu pra desmontar um filtro de água uma vez. Tinha uma coisa viva lá dentro. Nunca contei pra ninguém."
requires = Array[String](["diario_helena"])

[resource]
script = ExtResource("2_eukhs")
npc = "Brando"
greetings = Array[ExtResource("1_t0goa")]([SubResource("Resource_2nycl")])
