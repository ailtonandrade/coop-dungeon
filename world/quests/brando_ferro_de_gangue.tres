[resource]
script = ExtResource("1_def")
id = "brando_ferro_de_gangue"
title = "Ferro de gangue"
giver = "Brando"
offer_text = "Os bandidos de cano do pátio tão levando minha sucata e voltando pra cobrar 'pedágio' de quem passa. Derruba uns seis pra mim. Eu pago em parafuso e ainda afio tua arma de graça um dia."
progress_text = "Ainda tem cano batendo lá no pátio. Tô ouvindo daqui."
done_text = "Silêncio bom, esse. Toma o combinado. E não conta pra ninguém que eu paguei, senão vira fila."
summary = "Brando quer o pátio livre dos bandidos de cano."
objectives = Array[ExtResource("2_obj")]([SubResource("Resource_lgyhw")])
reward_gold = 150
reward_xp = 120
reward_item = "longbow"
repeatable = true
