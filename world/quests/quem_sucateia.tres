offer_keywords = PackedStringArray("sucata")
offer_replies = PackedStringArray("Sucata? Quem paga é gente da vila, mas ninguém negocia com forasteiro que nunca sujou a mão.")
offer_text = "Os bandidos de cano tomaram o Pátio dos Contêineres. Derruba uns cinco lá e volta aqui que eu te apresento."
progress_text = "Ainda tem cano batendo lá no pátio."
done_text = "Serviço limpo. Quem compra sucata por aqui é a Dona Alda, perto do bar. Fala que fui eu que mandei."
summary = "O Zé Gato sabe quem compra sucata, mas quer ver serviço antes."
